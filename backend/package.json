{
  "name": "sprout-task-manager-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Sprout Task Manager",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --check .",
    "db:seed": "npm run build && node dist/src/scripts/seed.js",
    "db:setup": "npm run db:seed",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "test": "tsx ./node_modules/mocha/bin/mocha.js \"test/**/*.spec.ts\" --exit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/sinon": "^22.0.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "chai": "^5.1.2",
    "mocha": "^12.0.3",
    "prettier": "^3.4.2",
    "sinon": "^22.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
